# Local development defaults to CMS_STORAGE_DRIVER=local.
# Copy to .env.local for local testing. Do not commit real secrets.

ADMIN_EMAIL=admin@aigenlabs.local
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_SECRET=replace-with-a-long-random-secret

# For Vercel/serverless production, use Supabase-backed CMS and Storage.
CMS_STORAGE_DRIVER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ_replace_me
# SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=landing-assets

# Optional, used by docs/deploy tooling and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.aigenlabs.com
